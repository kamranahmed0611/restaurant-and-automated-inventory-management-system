# ==============================================================================
# MUCHACHOS POS & ADMIN - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `.env.local` for local development.
# Configure these variables in Vercel Project Settings for cloud deployment.
# ==============================================================================

# Supabase Cloud Project Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Production Web / Cloud App URL (Optional, defaults to deployed host)
NEXT_PUBLIC_APP_URL=https://your-pos.vercel.app

# Deployment Target Restriction (Optional)
# Set to 'true' in Vercel to restrict web access exclusively to the Owner Admin Portal (/admin)
# and prevent unauthorized public access to the Cashier POS Terminal.
NEXT_PUBLIC_ADMIN_ONLY=false
